# ---- Site ----
# Public URL of the deployed site (used for canonical URLs, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase ----
# Project URL and anon (publishable) key are safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: SERVER ONLY. Used by server actions / route handlers (waitlist inserts, admin reads).
# Never expose with NEXT_PUBLIC_ and never ship to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Admin panel (Phase 0 gate; replaced by Supabase admin role in Phase 2) ----
# Password for /admin/login. Choose something long.
ADMIN_PASSWORD=
# Secret used to sign the admin session cookie. Generate: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# ---- Anti-abuse ----
# Salt for hashing submitter IPs in waitlist_leads.ip_hash (raw IPs are never stored).
IP_HASH_SALT=change-me

# ---- Email (optional) ----
# If RESEND_API_KEY is set, each new lead triggers a notification email to LEAD_NOTIFY_EMAIL.
RESEND_API_KEY=
# Must be a verified sender/domain in Resend.
RESEND_FROM_EMAIL="ShiftShield <leads@shiftshield.example>"
LEAD_NOTIFY_EMAIL=

# ---- Google Maps Platform (admin panel maps, Places autocomplete for sites; Phase 2+) ----
NEXT_PUBLIC_GOOGLE_MAPS_WEB_KEY=

# ---- Stripe (Phase 2+) ----
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Per-IP lead submission cap per 10 minutes. 0 or unset = disabled (open pilot).
LEAD_RATE_LIMIT=0
